      "visibility": "public"
    },
    {
      "name": "governance_notes",
      "category": "governance",
      "type": "string",
      "default": "",
      "description": "Public governance and decision-making notes.",
      "visibility": "public"
    },
    {
      "name": "programming_languages",
      "category": "interoperability",
      "type": "object_array",
      "description": "Programming languages used by the project. Entries include a name and may include version_constraint and role from the SMP.",
      "template_defaults": {
        "python": [
          {
            "name": "Python",
            "version_constraint": ">=3.12",
            "role": "primary"
          }
        ],
        "r": [
          {
            "name": "R",
            "version_constraint": ">=4.3",
            "role": "primary"
          }
        ]
      },
      "visibility": "public",
      "entry_schema": "programming_language"
    },
    {
      "name": "software_functions",
      "category": "interoperability",
