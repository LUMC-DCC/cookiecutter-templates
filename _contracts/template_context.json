      "visibility": "public"
    },
    {
      "name": "include_citation_cff",
      "category": "accessibility",
      "type": "choice",
      "choices": [
        "yes",
        "no"
      ],
      "default": "yes",
      "prompt": "Include citation file",
      "description": "Whether to include CITATION.cff citation metadata.",
      "visibility": "public"
    },
    {
      "name": "documentation_builder",
      "category": "documentation",
      "type": "choice",
      "choices": [
        "none",
        "mkdocs",
        "sphinx",
        "pkgdown"
      ],
      "default": "none",
      "template_supported_choices": {
        "python": [
          "none",
          "mkdocs",
          "sphinx"
        ],
        "r": [
          "none",
          "pkgdown"
        ]
      },
      "template_defaults": {
        "python": "sphinx",
        "r": "pkgdown"
      },
      "prompt": "Documentation builder",
      "description": "Documentation build system to scaffold or configure. Services may provide this directly; otherwise templates use language-specific defaults.",
      "visibility": "public"
    },
    {
      "name": "documentation_types",
      "category": "documentation",
      "type": "string_array",
      "description": "SMP documentation categories to scaffold. API and technical reference material are part of developer documentation.",
      "template_defaults": {
        "python": [
          "user",
          "deployment",
          "developer"
        ],
        "r": [
          "user",
          "deployment",
          "developer"
        ]
      },
      "visibility": "public",
      "item_schema": {
        "type": "string",
        "enum": [
          "user",
          "deployment",
          "developer"
        ]
      }
    },
    {
      "name": "include_contributing",
      "category": "documentation",
      "type": "choice",
      "choices": [
        "yes",
        "no"
      ],
      "default": "yes",
