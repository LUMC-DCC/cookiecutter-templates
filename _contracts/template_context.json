      "visibility": "public"
    },
    {
      "name": "include_governance",
      "category": "governance",
      "type": "choice",
      "choices": [
        "yes",
        "no"
      ],
      "default": "yes",
      "prompt": "Include governance file",
      "description": "Whether to include GOVERNANCE.md.",
      "visibility": "public"
    },
    {
      "name": "include_security",
      "category": "risk",
      "type": "choice",
      "choices": [
        "yes",
        "no"
      ],
      "default": "yes",
      "prompt": "Include security policy",
      "description": "Whether to include SECURITY.md.",
      "visibility": "public"
    },
    {
      "name": "include_support",
      "category": "documentation",
      "type": "choice",
      "choices": [
        "yes",
        "no"
      ],
      "default": "yes",
      "prompt": "Include support file",
      "description": "Whether to include SUPPORT.md.",
      "visibility": "public"
    },
    {
      "name": "include_changelog",
      "category": "release",
      "type": "choice",
      "choices": [
        "yes",
        "no"
      ],
      "default": "yes",
      "prompt": "Include changelog",
      "description": "Whether to include CHANGELOG.md.",
      "visibility": "public"
    },
    {
      "name": "support_routes",
      "category": "documentation",
      "type": "object_array",
      "description": "Public support, bug-reporting, or feature-request systems and their public URLs.",
      "visibility": "public",
      "entry_schema": "support_route"
    },
    {
      "name": "code_of_conduct_contact",
      "category": "governance",
      "type": "string",
      "default": "",
