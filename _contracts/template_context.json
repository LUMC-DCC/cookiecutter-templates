{
  "version": "0.8.0",
  "description": "Service-agnostic context accepted by the LUMC cookiecutter templates. Service-specific converters should map their own inputs to this contract before calling Cookiecutter.",
  "fields": [
    {
      "name": "language",
      "category": "routing",
      "type": "choice",
      "choices": [
        "python",
        "r"
      ],
      "template_defaults": {
        "python": "python",
        "r": "r"
      },
      "prompt": "Project language",
      "description": "Template directory to render. Use this to select Cookiecutter's directory argument.",
      "visibility": "public",
      "required": true
    },
    {
      "name": "project_name",
      "category": "identity",
      "type": "string",
      "default": "My Awesome Project",
      "prompt": "Project name",
      "description": "Human-readable project title.",
      "visibility": "public"
    },
    {
      "name": "project_slug",
      "category": "identity",
      "type": "string",
      "default": "my_awesome_project",
      "template_defaults": {
        "python": "my_awesome_project",
        "r": "my.awesome.project"
      },
      "prompt": "Project slug",
      "description": "Machine-readable package and repository name. Constraints depend on the selected language template.",
      "template_schemas": {
        "python": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "not": {
            "enum": [
              "and",
              "as",
              "assert",
              "async",
              "await",
              "break",
              "class",
              "continue",
              "def",
              "del",
              "elif",
              "else",
              "except",
              "finally",
              "for",
              "from",
              "global",
              "if",
              "import",
              "in",
              "is",
              "lambda",
              "nonlocal",
              "not",
              "or",
              "pass",
              "raise",
              "return",
              "try",
              "while",
              "with",
              "yield"
            ]
          },
          "description": "Use a lowercase Python identifier: start with a letter, then use lowercase letters, digits, or underscores; Python keywords are not allowed."
        },
        "r": {
          "minLength": 2,
          "pattern": "^[A-Za-z](?:[A-Za-z0-9.]*[A-Za-z0-9])$",
          "description": "Use an R package name of at least two ASCII letters, digits, or dots; start with a letter and do not end with a dot."
        }
      },
      "visibility": "public"
    },
    {
      "name": "project_short_description",
      "category": "identity",
      "type": "string",
      "default": "Research software project.",
      "prompt": "Short description",
      "description": "One-sentence description used in README and package metadata.",
      "visibility": "public"
    },
    {
      "name": "project_long_description",
      "category": "identity",
      "type": "string",
      "default": "",
      "prompt": "Long description",
      "description": "Longer public description of the project motivation and scope.",
      "visibility": "public"
    },
    {
      "name": "version",
      "category": "identity",
      "type": "string",
      "default": "0.1.0",
      "prompt": "Initial version",
      "description": "Initial project version.",
      "visibility": "public"
    },
    {
      "name": "development_status",
      "category": "identity",
      "type": "choice",
      "choices": [
        "concept",
        "wip",
        "active",
        "inactive",
        "suspended",
        "abandoned",
        "unsupported",
        "moved"
      ],
      "default": "concept",
      "prompt": "Development status",
      "description": "Current repostatus.org lifecycle status for the software.",
      "visibility": "public"
    },
    {
      "name": "keywords",
      "category": "identity",
      "type": "string_array",
      "description": "Public keywords used in package metadata, citation metadata, registries, and archives.",
      "visibility": "public",
      "item_schema": {
        "type": "string"
      }
    },
    {
      "name": "authors",
      "category": "people",
      "type": "object_array",
      "description": "People who created the software. Use name, or both given_names and family_names; entries may also include email, affiliation, orcid, roles, and url.",
      "visibility": "public",
      "entry_schema": "person"
    },
    {
      "name": "maintainers",
      "category": "people",
      "type": "object_array",
      "description": "People responsible for maintenance. Use name, or both given_names and family_names; entries may also include email, affiliation, orcid, roles, and url.",
      "visibility": "public",
      "entry_schema": "person"
    },
    {
      "name": "principal_investigators",
      "category": "people",
      "type": "object_array",
      "description": "Principal investigators associated with the project. Use name, or both given_names and family_names; entries may also include email, affiliation, orcid, roles, and url.",
      "visibility": "public",
      "entry_schema": "person"
    },
    {
      "name": "organization_name",
      "category": "people",
      "type": "string",
      "default": "LUMC",
      "prompt": "Organization",
      "description": "Primary organization responsible for the project.",
      "visibility": "public"
    },
    {
      "name": "funding",
      "category": "funding",
      "type": "object_array",
      "description": "Public funding records. Entries may include funder, award_number, award_title, grant_url, and project_code.",
      "visibility": "public",
      "entry_schema": "funding"
    },
    {
      "name": "purpose",
      "category": "motivation",
      "type": "string",
      "default": "",
      "prompt": "Purpose",
      "description": "Public statement of why the software exists.",
      "visibility": "public"
    },
    {
      "name": "purpose_categories",
      "category": "motivation",
      "type": "string_array",
      "description": "Public purpose categories such as data collection, analysis, simulation, visualization, reuse, or integration.",
      "visibility": "public",
      "item_schema": {
        "type": "string",
        "enum": [
          "Data collection & instrumentation",
          "Data analysis",
          "Simulation",
          "Visualization & dissemination",
          "Software reuse",
          "Integration & interfacing"
        ]
      }
    },
    {
      "name": "audiences",
      "category": "motivation",
      "type": "string_array",
      "description": "Intended users or stakeholder groups.",
      "visibility": "public",
      "item_schema": {
        "type": "string"
      }
    },
    {
      "name": "related_software",
      "category": "motivation",
      "type": "object_array",
      "description": "Related or upstream tools. Entries may include name, url_or_doi, and relationship.",
      "visibility": "public",
      "entry_schema": "related_software"
    },
    {
      "name": "repository_url",
      "category": "accessibility",
      "type": "string",
      "default": "",
      "prompt": "Repository URL",
      "description": "Canonical source repository URL.",
      "visibility": "public"
    },
    {
      "name": "homepage_url",
      "category": "accessibility",
      "type": "string",
      "default": "",
      "prompt": "Homepage URL",
      "description": "Project homepage URL, if different from the repository.",
      "visibility": "public"
    },
    {
      "name": "documentation_url",
      "category": "accessibility",
      "type": "string",
      "default": "",
      "prompt": "Documentation URL",
      "description": "Published documentation URL.",
      "visibility": "public"
    },
    {
      "name": "registries",
      "category": "accessibility",
      "type": "object_array",
      "description": "Registry entries such as PyPI, CRAN, bio.tools, WorkflowHub, or institutional catalogues. Entries may include name, url_or_id, and notes.",
      "visibility": "public",
      "entry_schema": "registry"
    },
    {
      "name": "persistent_identifiers",
      "category": "accessibility",
      "type": "object_array",
      "description": "Persistent identifiers. Each entry declares its CFF identifier type and value, with an optional associated version.",
      "visibility": "public",
      "entry_schema": "persistent_identifier"
    },
    {
      "name": "publications",
      "category": "accessibility",
      "type": "object_array",
      "description": "Associated publications. Entries may include title, type, authors, doi, pmid, pmcid, url, citation, note, and preferred.",
      "visibility": "public",
      "entry_schema": "publication"
    },
    {
      "name": "license",
      "category": "licensing",
      "type": "string",
      "default": "",
      "prompt": "License",
      "description": "SPDX license identifier, custom license text, or empty to omit the license file.",
      "visibility": "public",
      "schema": {
        "type": "string"
      }
    },
    {
      "name": "license_compatibility_notes",
      "category": "licensing",
      "type": "string",
      "default": "",
