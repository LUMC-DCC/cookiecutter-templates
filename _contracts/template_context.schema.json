  "allOf": [
    {
      "if": {
        "properties": {
          "language": {
            "const": "python"
          }
        },
        "required": [
          "language"
        ]
      },
      "then": {
        "properties": {
          "project_slug": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "not": {
              "enum": [
                "and",
                "as",
                "assert",
                "async",
                "await",
                "break",
                "class",
                "continue",
                "def",
                "del",
                "elif",
                "else",
                "except",
                "finally",
                "for",
                "from",
                "global",
                "if",
                "import",
                "in",
                "is",
                "lambda",
                "nonlocal",
                "not",
                "or",
                "pass",
                "raise",
                "return",
                "try",
                "while",
                "with",
                "yield"
              ]
            },
            "description": "Use a lowercase Python identifier: start with a letter, then use lowercase letters, digits, or underscores; Python keywords are not allowed."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "language": {
            "const": "r"
          }
        },
        "required": [
          "language"
        ]
      },
      "then": {
        "properties": {
          "project_slug": {
            "minLength": 2,
            "pattern": "^[A-Za-z](?:[A-Za-z0-9.]*[A-Za-z0-9])$",
            "description": "Use an R package name of at least two ASCII letters, digits, or dots; start with a letter and do not end with a dot."
          }
        }
      }
    }
  ]
