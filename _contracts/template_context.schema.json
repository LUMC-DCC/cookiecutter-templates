{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumc-dcc.github.io/cookiecutter-templates/template_context.schema.json",
  "title": "LUMC cookiecutter template context",
  "description": "Service-agnostic context accepted by the LUMC cookiecutter templates. Service-specific converters should map their own inputs to this contract before calling Cookiecutter.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "language": {
      "type": "string",
      "enum": [
        "python",
        "r"
      ],
      "description": "Template directory to render. Use this to select Cookiecutter's directory argument."
    },
    "project_name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable project title.",
      "default": "My Awesome Project"
    },
    "project_slug": {
      "type": "string",
      "description": "Machine-readable package and repository name. Constraints depend on the selected language template.",
      "default": "my_awesome_project"
    },
    "project_short_description": {
      "type": "string",
      "minLength": 1,
      "description": "One-sentence description used in README and package metadata.",
      "default": "Research software project."
    },
    "project_long_description": {
      "type": "string",
      "description": "Longer public description of the project motivation and scope.",
      "default": ""
    },
    "version": {
      "type": "string",
      "description": "Initial project version.",
      "default": "0.1.0"
    },
    "development_status": {
      "type": "string",
      "enum": [
        "concept",
        "wip",
        "active",
        "inactive",
        "suspended",
        "abandoned",
        "unsupported",
        "moved"
      ],
      "description": "Current repostatus.org lifecycle status for the software.",
      "default": "concept"
    },
    "keywords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Public keywords used in package metadata, citation metadata, registries, and archives."
    },
    "authors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/person"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "People who created the software. Use name, or both given_names and family_names; entries may also include email, affiliation, orcid, roles, and url."
    },
    "maintainers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/person"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "People responsible for maintenance. Use name, or both given_names and family_names; entries may also include email, affiliation, orcid, roles, and url."
    },
    "principal_investigators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/person"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Principal investigators associated with the project. Use name, or both given_names and family_names; entries may also include email, affiliation, orcid, roles, and url."
    },
    "organization_name": {
      "type": "string",
      "description": "Primary organization responsible for the project.",
      "default": "LUMC"
    },
    "funding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/funding"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Public funding records. Entries may include funder, award_number, award_title, grant_url, and project_code."
    },
    "purpose": {
      "type": "string",
      "description": "Public statement of why the software exists.",
      "default": ""
    },
    "purpose_categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Data collection & instrumentation",
              "Data analysis",
              "Simulation",
              "Visualization & dissemination",
              "Software reuse",
              "Integration & interfacing"
            ]
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Public purpose categories such as data collection, analysis, simulation, visualization, reuse, or integration."
    },
    "problem_statement": {
      "type": "string",
      "description": "Public statement of the research or operational problem the software addresses.",
      "default": ""
    },
    "value_proposition": {
      "type": "string",
      "description": "Public explanation of the software's value and why new development is justified.",
      "default": ""
    },
    "audiences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Intended users or stakeholder groups."
    },
    "related_software": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/related_software"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Related or upstream tools. Entries may include name, url_or_doi, and relationship."
    },
    "repository_url": {
      "type": "string",
      "description": "Canonical source repository URL.",
      "default": ""
    },
    "homepage_url": {
      "type": "string",
      "description": "Project homepage URL, if different from the repository.",
      "default": ""
    },
    "documentation_url": {
      "type": "string",
      "description": "Published documentation URL.",
      "default": ""
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registry"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Registry entries such as PyPI, CRAN, bio.tools, WorkflowHub, or institutional catalogues. Entries may include name, url_or_id, and notes."
    },
    "persistent_identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/persistent_identifier"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Persistent identifiers. Each entry declares its CFF identifier type and value, with an optional associated version."
    },
    "publications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publication"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Associated publications. Entries may include title, type, authors, doi, pmid, pmcid, url, citation, note, and preferred."
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier, custom license text, or empty to omit the license file.",
      "default": ""
    },
    "license_compatibility_notes": {
      "type": "string",
      "description": "Public notes about compatibility with dependencies, upstream code, data, or documentation licenses.",
      "default": ""
    },
    "license_compatibility_check": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ],
      "description": "Whether generated CI should check Python dependency license compatibility.",
      "default": "no"
    },
    "include_citation_cff": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ],
      "description": "Whether to include CITATION.cff citation metadata.",
      "default": "yes"
    },
    "documentation_builder": {
      "type": "string",
      "enum": [
        "none",
        "mkdocs",
        "sphinx",
        "pkgdown"
      ],
      "description": "Documentation build system to scaffold or configure. Services may provide this directly; otherwise templates use language-specific defaults.",
      "default": "none"
    },
    "documentation_types": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "user",
              "deployment",
              "developer"
            ]
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "SMP documentation categories to scaffold. API and technical reference material are part of developer documentation."
    },
    "community_files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CONTRIBUTING.md",
              "CODE_OF_CONDUCT.md",
              "GOVERNANCE.md",
              "SECURITY.md",
              "SUPPORT.md",
              "CHANGELOG.md"
            ]
          }
        }
      },
      "default": {
        "entries": [
          "CONTRIBUTING.md",
          "CODE_OF_CONDUCT.md",
          "GOVERNANCE.md",
          "SECURITY.md",
          "SUPPORT.md",
          "CHANGELOG.md"
        ]
      },
      "description": "Standard root community files to include. Selecting CONTRIBUTING.md or SUPPORT.md also includes the corresponding GitHub collaboration templates."
    },
    "support_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/support_route"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Public support, bug-reporting, or feature-request systems and their public URLs."
    },
    "code_of_conduct_contact": {
      "type": "string",
      "description": "Public private-contact route for code-of-conduct reports.",
      "default": ""
    },
    "governance_notes": {
      "type": "string",
      "description": "Public governance and decision-making notes.",
      "default": ""
    },
    "programming_languages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/programming_language"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Programming languages used by the project. Entries include a name and may include version_constraint and role from the SMP."
    },
    "software_functions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/software_function"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Functions or operations performed by the software. Entries may include summary, operation, input, output, cmd, and note."
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interface"
          }
        }
      },
      "default": {
        "entries": [
          {
            "type": "Library"
          }
        ]
      },
      "description": "Interfaces exposed by the software. Type controls the scaffold; specification and status describe the selected interface."
    },
    "operating_systems": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operating_system"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Supported operating systems or platforms. Entries may include name, specification, and status from the SMP."
    },
    "external_dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external_dependency"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "External software dependencies or standards. Entries may include name, version_constraint, url, license, and purpose."
    },
    "external_services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external_service"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "External public services, partners, or roles needed by the project. Entries may include name, provider, service_types, quantity, and cost_coverage."
    },
    "test_types": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Smoke tests",
              "Doctests",
              "Unit tests",
              "Integration tests",
              "System / end-to-end tests",
              "Regression tests",
              "Property-based / fuzz"
            ]
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Types of tests used or desired. Supported values match the SMP testing checklist."
    },
    "test_frameworks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pytest",
              "unittest",
              "doctest",
              "testthat",
              "Catch2",
              "GoogleTest",
              "cargo test",
              "JUnit 5",
              "Vitest",
              "Jest",
              "bats-core"
            ]
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Testing frameworks used by the project."
    },
    "formatter_tool": {
      "type": "string",
      "enum": [
        "none",
        "ruff",
        "black",
        "styler",
        "prettier",
        "rustfmt",
        "clang-format"
      ],
      "description": "Primary code formatter."
    },
    "linter_tool": {
      "type": "string",
      "enum": [
        "none",
        "ruff",
        "flake8",
        "pylint",
        "lintr",
        "eslint",
        "clippy",
        "clang-tidy"
      ],
      "description": "Primary static analysis tool."
    },
    "type_checker": {
      "type": "string",
      "enum": [
        "none",
        "mypy",
        "pyright",
        "basedpyright",
        "pyre",
        "tsc",
        "rustc",
        "Flow"
      ],
      "description": "Primary static type checker."
    },
    "project_manager": {
      "type": "string",
      "enum": [
        "uv",
        "poetry",
        "pdm",
        "hatch",
        "pixi",
        "pip",
        "renv",
        "rix",
        "cargo",
        "npm",
        "pnpm",
        "yarn",
        "maven",
        "gradle",
        "cmake"
      ],
      "description": "Primary project and dependency manager. Template-specific choices control setup, command execution, lockfile handling, and CI."
    },
    "versioning_scheme": {
      "type": "string",
      "enum": [
        "SemVer",
        "CalVer",
        "Custom"
      ],
      "description": "Controlled versioning policy. Use versioning_scheme_details for the exact CalVer pattern or a custom policy.",
      "default": "SemVer"
    },
    "versioning_scheme_details": {
      "type": "string",
      "description": "Exact CalVer pattern or public explanation of a custom versioning policy.",
      "default": ""
    },
    "release_frequency": {
      "type": "string",
      "description": "Expected or actual release frequency.",
      "default": ""
    },
    "distribution_channels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "PyPI",
              "conda-forge",
              "CRAN",
              "Bioconductor",
              "npm",
              "crates.io",
              "Docker Hub",
              "GitHub Container Registry",
              "Quay",
              "Apptainer Library",
              "BioContainers",
              "GitHub Releases",
              "Zenodo",
              "Institutional archive",
              "Source repository",
              "Self-hosted installer",
              "Hosted service",
              "Other"
            ]
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Controlled public distribution routes, including package registries, releases, archives, source installation, installers, and hosted services."
    },
    "containerization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/containerization"
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Container recipes to generate. Project managers and lockfiles are configured separately."
    },
    "resource_requirements": {
      "type": "string",
      "description": "Public typical and worst-case memory, storage, compute, GPU, wall-clock, or scaling requirements.",
      "default": ""
    },
    "maintenance_level": {
      "type": "string",
      "enum": [
        "",
        "Active/routine maintenance",
        "Security maintenance only",
        "Best-effort maintenance / no timeline commitment"
      ],
      "description": "Public maintenance commitment after active development winds down; leave empty when no commitment is declared.",
      "default": ""
    },
    "continuity_plan": {
      "type": "string",
      "description": "Public continuity or handover plan.",
      "default": ""
    },
    "retirement_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Project completed",
              "Replaced by successor software",
              "Obsolete technology / architecture",
              "Incompatible with current systems",
              "Loss or end of funding",
              "Lack of maintainers",
              "Institutional shift in priorities",
              "Retirement of critical dependencies",
              "Discontinuation of hosting / infrastructure",
              "Change in legal or regulatory requirements",
              "Security / privacy risks",
              "Lack of user demand or adoption",
              "Declining utility or relevance"
            ]
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Public conditions under which the software may be retired."
    },
    "public_risk_notes": {
      "type": "string",
      "description": "Public risk or mitigation notes. Sensitive security, privacy, or compliance details should not be included.",
      "default": ""
    },
    "regulatory_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "GDPR - General Data Protection Regulation (EU data protection)",
              "MDR / IVDR - EU Medical Device Regulation / In Vitro Diagnostic Regulation",
              "Other EU or National Regulations (e.g., Dutch WMO, data processing agreements)",
              "ISO/IEC 27001 - Information Security Management",
              "ISO 13485 - Quality Management for Medical Devices",
              "ISO/IEC 90003 - Software Engineering (guidelines for ISO 9001)",
              "ISO/IEC 12207 - Software Lifecycle Processes",
              "GxP / Good Clinical Practice",
              "Ethical Approval / IRB Requirements",
              "Funding Programme Requirements (e.g., Horizon Europe, NWO, ELIXIR)",
              "Institutional Security Policies",
              "Departmental SOP (Zenya / EDR)",
              "Journal data/software-availability requirement",
              "Commissie Good Research Practice (GRP)"
            ]
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Public regulatory, quality, policy, or availability requirements that shape the software project."
    },
    "additional_regulatory_requirements": {
      "type": "string",
      "description": "Public regulatory or policy requirements not represented by the controlled regulatory_requirements choices.",
      "default": ""
    },
    "security_contact": {
      "type": "string",
      "description": "Public private-contact route for vulnerability reports.",
      "default": ""
    },
    "security_measures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "User authentication (e.g., password, OAuth, SSO)",
              "Role-based access control (RBAC) or permissions system",
              "Data encryption at rest",
              "Data encryption in transit (e.g., HTTPS/TLS)",
              "Regular dependency / library updates",
              "Security patch management process",
              "Vulnerability scanning (e.g., Snyk, Dependabot)",
              "Secrets management (e.g., environment variables, vault)",
              "Network security (e.g., firewalls, VPN, isolated subnets)",
              "Secure configuration management (e.g., Infrastructure-as-Code, hardening)",
              "Audit logging / intrusion detection",
              "Penetration testing or security review",
              "Follows institutional or regulatory security policies (e.g., ISO 27001, NEN 7510)"
            ]
          }
        }
      },
      "default": {
        "entries": []
      },
      "description": "Controlled public security measures protecting the software and its data."
    },
    "additional_security_measures": {
      "type": "string",
      "description": "Public security measures not represented by the controlled security_measures choices.",
      "default": ""
    },
    "sensitive_data_statement": {
      "type": "string",
      "description": "Public statement about whether the software handles personal or sensitive data, without exposing restricted details.",
      "default": ""
    },
    "dmp_reference": {
      "type": "string",
      "description": "Public DMP reference or contact route when appropriate.",
      "default": ""
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "given_names",
            "family_names"
          ]
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "given_names": {
          "type": "string",
          "minLength": 1
        },
        "family_names": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "affiliation": {
          "$ref": "#/$defs/organization"
        },
        "orcid": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Original author",
              "Co-author",
              "Maintainer",
              "Successor",
              "Principal investigator"
            ]
          }
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
