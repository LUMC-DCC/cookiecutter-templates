{% macro yaml_string(value) -%}
"{{ value | replace('"', '\\"') }}"
{%- endmacro %}
{% macro person_name(person) -%}
{% if person.name is defined and person.name %}
{{ person.name }}
{% else %}
{% set given_names = person.given_names if person.given_names is defined else "" %}
{% set family_names = person.family_names if person.family_names is defined else "" %}
{{ (given_names ~ " " ~ family_names) | trim or "Project member" }}
{% endif %}
{%- endmacro %}
{% macro cff_person(person) %}
{% if (person.family_names is defined and person.family_names) or (person.given_names is defined and person.given_names) %}
  - family-names: {{ yaml_string(person.family_names if person.family_names is defined and person.family_names else person_name(person) | trim) }}
{% if person.given_names is defined and person.given_names %}
    given-names: {{ yaml_string(person.given_names) }}
{% endif %}
{% if person.affiliation is defined and person.affiliation %}
    affiliation: {{ yaml_string(person.affiliation.name) }}
{% endif %}
{% else %}
  - name: {{ yaml_string(person_name(person) | trim) }}
{% endif %}
{% if person.email is defined and person.email %}
    email: {{ yaml_string(person.email) }}
{% endif %}
{% if person.orcid is defined and person.orcid %}
{% if person.orcid.startswith("https://orcid.org/") %}
    orcid: {{ yaml_string(person.orcid) }}
{% else %}
    orcid: {{ yaml_string("https://orcid.org/" ~ person.orcid) }}
{% endif %}
{% endif %}
{% if person.url is defined and person.url %}
    website: {{ yaml_string(person.url) }}
{% endif %}
{% endmacro %}
{% macro publication_title(publication) -%}
{% if publication.title is defined and publication.title %}
{{ publication.title }}
{% elif publication.citation is defined and publication.citation %}
{{ publication.citation }}
{% elif publication.doi is defined and publication.doi %}
Publication {{ publication.doi }}
{% elif publication.url is defined and publication.url %}
Publication {{ publication.url }}
{% elif publication.pmid is defined and publication.pmid %}
Publication PMID {{ publication.pmid }}
{% elif publication.pmcid is defined and publication.pmcid %}
Publication {{ publication.pmcid }}
{% else %}
Associated publication
{% endif %}
{%- endmacro %}
{% macro registry_url(registry) -%}
{% set normalized_name = registry.name | lower | replace(".", "") | replace("-", "") | replace(" ", "") %}
{% if registry.url_or_id.startswith("http://") or registry.url_or_id.startswith("https://") %}
{{ registry.url_or_id }}
{% elif normalized_name == "biotools" %}
https://bio.tools/{{ registry.url_or_id | replace("biotools:", "") }}
{% elif normalized_name == "pypi" %}
https://pypi.org/project/{{ registry.url_or_id }}/
{% elif normalized_name == "cran" %}
https://cran.r-project.org/package={{ registry.url_or_id }}
{% else %}
{{ registry.url_or_id }}
{% endif %}
{%- endmacro %}
{% macro cff_publication_reference(publication, indent, bullet=False) %}
{% set requested_type = publication.type | lower | replace(" ", "-") if publication.type is defined and publication.type else "article" %}
{% set cff_types = ["art", "article", "audiovisual", "bill", "blog", "book", "catalogue", "conference-paper", "conference", "data", "database", "dictionary", "edited-work", "encyclopedia", "film-broadcast", "generic", "government-document", "grant", "hearing", "historical-work", "legal-case", "legal-rule", "magazine-article", "manual", "map", "multimedia", "music", "newspaper-article", "pamphlet", "patent", "personal-communication", "proceedings", "report", "serial", "slides", "software-code", "software-container", "software-executable", "software-virtual-machine", "software", "sound-recording", "standard", "statute", "thesis", "unpublished", "video", "website"] %}
{% set publication_type = requested_type if requested_type in cff_types else "generic" %}
{% set first_indent = indent ~ "- " if bullet else indent %}
{% set field_indent = indent ~ "  " if bullet else indent %}
{{ first_indent }}type: {{ publication_type }}
{{ field_indent }}title: {{ yaml_string(publication_title(publication) | trim) }}
{% if publication.authors is defined and publication.authors %}
{{ field_indent }}authors:
{% for author in publication.authors %}
{{ cff_person(author) | indent(width=2, first=True) }}
{% endfor %}
{% endif %}
{% if publication.doi is defined and publication.doi %}
{{ field_indent }}doi: {{ yaml_string(publication.doi | replace("https://doi.org/", "") | replace("http://dx.doi.org/", "") | replace("http://doi.org/", "")) }}
{% endif %}
{% if publication.pmcid is defined and publication.pmcid %}
{{ field_indent }}pmcid: {{ yaml_string(publication.pmcid) }}
{% endif %}
{% if publication.url is defined and publication.url %}
{{ field_indent }}url: {{ yaml_string(publication.url) }}
{% endif %}
{% if publication.pmid is defined and publication.pmid %}
{{ field_indent }}identifiers:
{{ field_indent }}  - type: "other"
{{ field_indent }}    value: {{ yaml_string("PMID:" ~ publication.pmid) }}
{{ field_indent }}    description: "PMID"
{% endif %}
{% if publication.note is defined and publication.note %}
{{ field_indent }}notes: {{ yaml_string(publication.note) }}
{% endif %}
{% endmacro %}
cff-version: "1.2.0"
message: {{ yaml_string("If you use this software, please cite it using the metadata in this file.") }}
title: {{ yaml_string(cookiecutter.project_name) }}
type: software
version: {{ yaml_string(cookiecutter.version) }}
abstract: {{ yaml_string(cookiecutter.project_long_description or cookiecutter.project_short_description) }}
{% if cookiecutter.repository_url %}
repository-code: {{ yaml_string(cookiecutter.repository_url) }}
{% endif %}
{% if cookiecutter.homepage_url or cookiecutter.documentation_url %}
url: {{ yaml_string(cookiecutter.homepage_url or cookiecutter.documentation_url) }}
{% endif %}
authors:
{% if cookiecutter.authors.entries %}
{% for author in cookiecutter.authors.entries %}
{{ cff_person(author) }}
{% endfor %}
{% else %}
  - name: {{ yaml_string(cookiecutter.organization_name) }}
{% endif %}
{% if cookiecutter.maintainers.entries %}
contact:
{% for maintainer in cookiecutter.maintainers.entries %}
{{ cff_person(maintainer) }}
{% endfor %}
{% endif %}
{% if cookiecutter.keywords.entries %}
keywords:
{% for keyword in cookiecutter.keywords.entries %}
  - {{ yaml_string(keyword) }}
{% endfor %}
{% endif %}
{% set registry_identifiers = cookiecutter.registries.entries | selectattr("url_or_id", "defined") | selectattr("url_or_id") | list %}
{% if cookiecutter.persistent_identifiers.entries or registry_identifiers %}
identifiers:
{% for identifier in cookiecutter.persistent_identifiers.entries %}
{% set identifier_type = identifier.type | lower %}
  - type: {{ yaml_string(identifier_type if identifier_type in ["doi", "url", "swh"] else "other") }}
    value: {{ yaml_string(identifier.identifier) }}
{% if identifier.associated_version is defined and identifier.associated_version %}
    description: {{ yaml_string("Persistent identifier for version " ~ identifier.associated_version) }}
{% endif %}
{% endfor %}
{% for registry in registry_identifiers %}
  - type: "other"
    value: {{ yaml_string(registry_url(registry) | trim) }}
{% if registry.name %}
    description: {{ yaml_string(registry.name) }}
{% endif %}
{% endfor %}
{% endif %}
{% set preferred_publications = [] %}
{% for publication in cookiecutter.publications.entries %}
{% if publication.preferred is defined and publication.preferred and publication.authors is defined and publication.authors %}
{% set _ = preferred_publications.append(publication) %}
{% endif %}
{% endfor %}
{% if preferred_publications %}
preferred-citation:
{{ cff_publication_reference(preferred_publications[0], "  ") }}
{% endif %}
{% set cff_publications = [] %}
{% for publication in cookiecutter.publications.entries %}
{% if publication.authors is defined and publication.authors %}
{% set _ = cff_publications.append(publication) %}
{% endif %}
{% endfor %}
{% if cff_publications %}
references:
{% for publication in cff_publications %}
{{ cff_publication_reference(publication, "  ", True) }}
{% endfor %}
{% endif %}
