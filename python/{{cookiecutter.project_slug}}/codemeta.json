{% macro person_name(person) %}
{% if person.name is defined and person.name %}
{{ person.name }}
{% else %}
{% set given_names = person.given_names if person.given_names is defined else "" %}
{% set family_names = person.family_names if person.family_names is defined else "" %}
{{ (given_names ~ " " ~ family_names) | trim or "Project member" }}
{% endif %}
{% endmacro %}
{% macro codemeta_organization(organization) %}
      {
        "@type": "Organization",
{% if organization.identifier is defined and organization.identifier %}
        "@id": {{ organization.identifier | tojson }},
{% endif %}
        "name": {{ organization.name | tojson }}
{% if organization.email is defined and organization.email %},
        "email": {{ organization.email | tojson }}
{% endif %}
{% if organization.url is defined and organization.url %},
        "url": {{ organization.url | tojson }}
{% endif %}
{% if organization.address is defined and organization.address %},
        "address": {{ organization.address | tojson }}
{% endif %}
      }
{% endmacro %}
{% macro codemeta_person(person) %}
    {
      "@type": "Person",
{% if person.orcid is defined and person.orcid %}
      "@id": {{ (person.orcid if person.orcid.startswith("https://orcid.org/") else "https://orcid.org/" ~ person.orcid) | tojson }},
{% elif person.url is defined and person.url %}
      "@id": {{ person.url | tojson }},
{% endif %}
      "name": {{ (person_name(person) | trim) | tojson }}
{% if person.given_names is defined and person.given_names %},
      "givenName": {{ person.given_names | tojson }}
{% endif %}
{% if person.family_names is defined and person.family_names %},
      "familyName": {{ person.family_names | tojson }}
{% endif %}
{% if person.email is defined and person.email %},
      "email": {{ person.email | tojson }}
{% endif %}
{% if person.affiliation is defined and person.affiliation %},
      "affiliation": {{ codemeta_organization(person.affiliation) | trim }}
{% endif %}
{% if person.url is defined and person.url %},
      "url": {{ person.url | tojson }}
{% endif %}
    }
{% endmacro %}
{% macro codemeta_dependency(dependency) %}
    {
      "@type": "SoftwareSourceCode",
{% if dependency.url is defined and dependency.url %}
      "@id": {{ dependency.url | tojson }},
{% endif %}
      "name": {{ dependency.name | tojson }}
{% if dependency.url is defined and dependency.url %},
      "url": {{ dependency.url | tojson }}
{% endif %}
{% if dependency.version_constraint is defined and dependency.version_constraint %},
      "version": {{ dependency.version_constraint | tojson }}
{% endif %}
{% if dependency.license is defined and dependency.license %},
      "license": {{ (dependency.license if dependency.license.startswith("http://") or dependency.license.startswith("https://") else "https://spdx.org/licenses/" ~ dependency.license) | tojson }}
{% endif %}
{% if dependency.purpose is defined and dependency.purpose %},
      "description": {{ dependency.purpose | tojson }}
{% endif %}
    }
{% endmacro %}
{% macro registry_url(registry) %}
{% set normalized_name = registry.name | lower | replace(".", "") | replace("-", "") | replace(" ", "") %}
{% if registry.url_or_id is defined and registry.url_or_id and (registry.url_or_id.startswith("http://") or registry.url_or_id.startswith("https://")) %}
{{ registry.url_or_id }}
{% elif normalized_name == "biotools" and registry.url_or_id is defined and registry.url_or_id %}
https://bio.tools/{{ registry.url_or_id | replace("biotools:", "") }}
{% elif normalized_name == "pypi" and registry.url_or_id is defined and registry.url_or_id %}
https://pypi.org/project/{{ registry.url_or_id }}/
{% elif normalized_name == "cran" and registry.url_or_id is defined and registry.url_or_id %}
https://cran.r-project.org/package={{ registry.url_or_id }}
{% endif %}
{% endmacro %}
{% macro publication_link(publication) %}
{% if publication.doi is defined and publication.doi %}
{{ publication.doi if publication.doi.startswith("http://") or publication.doi.startswith("https://") else "https://doi.org/" ~ publication.doi }}
{% elif publication.url is defined and publication.url %}
{{ publication.url }}
{% elif publication.pmcid is defined and publication.pmcid %}
https://www.ncbi.nlm.nih.gov/pmc/articles/{{ publication.pmcid }}/
{% elif publication.pmid is defined and publication.pmid %}
https://pubmed.ncbi.nlm.nih.gov/{{ publication.pmid }}/
{% endif %}
{% endmacro %}
{% set interface_types = [] %}
{% for interface in cookiecutter.interfaces.entries %}
{% if interface.type is defined and interface.type and interface.type not in interface_types %}
{% set _ = interface_types.append(interface.type) %}
{% endif %}
{% endfor %}
{% set features = [] %}
{% for software_function in cookiecutter.software_functions.entries %}
{% for operation in software_function.operation if software_function.operation is defined %}
{% set feature = operation.uri if operation.uri is defined and operation.uri else operation.term if operation.term is defined else "" %}
{% if feature and feature not in features %}{% set _ = features.append(feature) %}{% endif %}
{% endfor %}
{% if software_function.summary is defined and software_function.summary and not software_function.operation and software_function.summary not in features %}
{% set _ = features.append(software_function.summary) %}
{% endif %}
{% endfor %}
{% if not features %}{% set _ = features.append(cookiecutter.purpose or cookiecutter.project_short_description) %}{% endif %}
{% set registry_links = [] %}
{% for registry in cookiecutter.registries.entries %}
{% set link = registry_url(registry) | trim %}
{% if link and link not in registry_links %}{% set _ = registry_links.append(link) %}{% endif %}
{% endfor %}
{% set support_urls = [] %}
{% for route in cookiecutter.support_routes.entries %}
{% if route.url is defined and route.url %}
{% set _ = support_urls.append(route.url) %}
{% endif %}
{% endfor %}
{% set runtime_platforms = [] %}
{% for programming_language in cookiecutter.programming_languages.entries %}
{% if programming_language.name is defined and programming_language.name %}
{% set runtime = programming_language.name ~ (" " ~ programming_language.version_constraint if programming_language.version_constraint is defined and programming_language.version_constraint else "") %}
{% if runtime not in runtime_platforms %}{% set _ = runtime_platforms.append(runtime) %}{% endif %}
{% endif %}
{% endfor %}
{% for container in cookiecutter.containerization.entries %}
{% if container.type is defined and container.type and container.type not in runtime_platforms %}{% set _ = runtime_platforms.append(container.type) %}{% endif %}
{% endfor %}
{% set supporting_data = [] %}
{% set supporting_data_urls = [] %}
{% for software_function in cookiecutter.software_functions.entries %}
{% for io_record in software_function.input if software_function.input is defined %}
{% for data_format in io_record.format if io_record.format is defined %}
{% if data_format.sample_url is defined and data_format.sample_url and data_format.sample_url not in supporting_data_urls %}
{% set _ = supporting_data_urls.append(data_format.sample_url) %}
{% set _ = supporting_data.append({"name": data_format.term if data_format.term is defined and data_format.term else "Example input data", "url": data_format.sample_url}) %}
{% endif %}
{% endfor %}
{% endfor %}
{% for io_record in software_function.output if software_function.output is defined %}
{% for data_format in io_record.format if io_record.format is defined %}
{% if data_format.sample_url is defined and data_format.sample_url and data_format.sample_url not in supporting_data_urls %}
{% set _ = supporting_data_urls.append(data_format.sample_url) %}
{% set _ = supporting_data.append({"name": data_format.term if data_format.term is defined and data_format.term else "Example output data", "url": data_format.sample_url}) %}
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}
{% set has_quality_ci = cookiecutter.formatter_tool != "none" or cookiecutter.linter_tool != "none" or cookiecutter.type_checker != "none" %}
{% set has_generated_ci = cookiecutter.include_citation_cff == "yes" or "CHANGELOG.md" in cookiecutter.community_files.entries or cookiecutter.documentation_types.entries or cookiecutter.test_types.entries or has_quality_ci or cookiecutter.containerization.entries or cookiecutter.distribution_channels.entries or (cookiecutter.license and cookiecutter.license_compatibility_check == "yes") %}
{
  "@context": [
    "https://w3id.org/codemeta/3.1",
    {
      "schema": "https://schema.org/"
    }
  ],
  "@type": "SoftwareSourceCode",
  "name": {{ cookiecutter.project_name | tojson }},
  "description": {{ (cookiecutter.project_long_description or cookiecutter.project_short_description) | tojson }},
  "version": {{ cookiecutter.version | tojson }},
  "developmentStatus": {{ cookiecutter.development_status | tojson }},
  "applicationCategory": {% if not interface_types %}"Library"{% elif interface_types | length == 1 %}{{ interface_types[0] | tojson }}{% else %}{{ interface_types | tojson }}{% endif %},
{% if cookiecutter.purpose_categories.entries %}
  "applicationSubCategory": {{ cookiecutter.purpose_categories.entries | tojson }},
{% endif %}
  "schema:featureList": {{ features | tojson }},
  "programmingLanguage": [
{% if cookiecutter.programming_languages.entries %}
{% for programming_language in cookiecutter.programming_languages.entries %}
    {
      "@type": "ComputerLanguage",
      "name": {{ programming_language.name | tojson }}{% if programming_language.version_constraint is defined and programming_language.version_constraint %},
      "version": {{ programming_language.version_constraint | tojson }}{% endif %}
    }{% if not loop.last %},{% endif %}
{% endfor %}
{% else %}
    {{ cookiecutter.language | capitalize | tojson }}
{% endif %}
  ],
  "author": [
{% if cookiecutter.authors.entries %}
{% for author in cookiecutter.authors.entries %}
{{ codemeta_person(author) }}{% if not loop.last %},{% endif %}
{% endfor %}
{% else %}
    {
      "@type": "Organization",
      "name": {{ cookiecutter.organization_name | tojson }}
    }
{% endif %}
  ]
,
  "identifier": [
{% if cookiecutter.persistent_identifiers.entries %}
{% for identifier in cookiecutter.persistent_identifiers.entries %}
{% set identifier_type = identifier.type | lower %}
{% if identifier_type == "doi" %}
    {{ (identifier.identifier if identifier.identifier.startswith("http://") or identifier.identifier.startswith("https://") else "https://doi.org/" ~ identifier.identifier) | tojson }}{% if not loop.last %},{% endif %}
{% elif identifier.identifier.startswith("http://") or identifier.identifier.startswith("https://") %}
    {{ identifier.identifier | tojson }}{% if not loop.last %},{% endif %}
{% else %}
    {
      "@type": "PropertyValue",
      "propertyID": {{ identifier.type | tojson }},
      "value": {{ identifier.identifier | tojson }}{% if identifier.associated_version is defined and identifier.associated_version %},
      "description": {{ ("Persistent identifier for version " ~ identifier.associated_version) | tojson }}{% endif %}
    }{% if not loop.last %},{% endif %}
{% endif %}
{% endfor %}
{% else %}
    {
      "@type": "PropertyValue",
      "propertyID": "placeholder",
      "value": "REPLACE_WITH_PERSISTENT_IDENTIFIER"
    }
{% endif %}
  ]
{% if cookiecutter.maintainers.entries %},
  "maintainer": [
{% for maintainer in cookiecutter.maintainers.entries %}
{{ codemeta_person(maintainer) }}{% if not loop.last %},{% endif %}
{% endfor %}
  ]
{% endif %}
{% if cookiecutter.principal_investigators.entries %},
  "contributor": [
{% for principal_investigator in cookiecutter.principal_investigators.entries %}
{{ codemeta_person(principal_investigator) }}{% if not loop.last %},{% endif %}
{% endfor %}
  ]
{% endif %}
{% if cookiecutter.organization_name %},
  "provider": {
    "@type": "Organization",
    "name": {{ cookiecutter.organization_name | tojson }}
  }
{% endif %}
{% if cookiecutter.keywords.entries %},
  "keywords": {{ cookiecutter.keywords.entries | tojson }}
{% endif %}
,
  "codeRepository": {{ (cookiecutter.repository_url or "https://example.org/REPLACE_WITH_REPOSITORY") | tojson }}
{% if cookiecutter.repository_url %}
{% if cookiecutter.repository_url.startswith("https://github.com/") and has_generated_ci %},
  "continuousIntegration": {{ (cookiecutter.repository_url.rstrip("/") ~ "/actions") | tojson }}
{% endif %}
{% endif %}
,
{% if cookiecutter.license %}
{% if cookiecutter.license.startswith("http://") or cookiecutter.license.startswith("https://") %}
  "license": {{ cookiecutter.license | tojson }}
{% elif "\n" not in cookiecutter.license and cookiecutter.license | length < 100 %}
  "license": {{ ("https://spdx.org/licenses/" ~ cookiecutter.license) | tojson }}
{% else %}
  "license": {
    "@type": "CreativeWork",
    "name": "Custom project license",
    "url": "https://example.org/REPLACE_WITH_CUSTOM_LICENSE_URL"
  }
{% endif %}
{% else %}
  "license": {
    "@type": "CreativeWork",
    "name": "REPLACE_WITH_PROJECT_LICENSE",
    "url": "https://example.org/REPLACE_WITH_LICENSE"
  }
{% endif %}
{% if cookiecutter.homepage_url or cookiecutter.documentation_url %},
  "url": {{ (cookiecutter.homepage_url or cookiecutter.documentation_url) | tojson }}
{% endif %}
{% if cookiecutter.documentation_url %},
  "softwareHelp": {
    "@type": "CreativeWork",
    "url": {{ cookiecutter.documentation_url | tojson }}
  }
{% endif %}
{% if support_urls %},
  "issueTracker": {{ support_urls[0] | tojson }}
{% endif %}
{% if "CHANGELOG.md" in cookiecutter.community_files.entries and cookiecutter.repository_url %},
  "releaseNotes": {{ (cookiecutter.repository_url.rstrip("/") ~ "/blob/HEAD/CHANGELOG.md") | tojson }}
{% endif %}
{% if runtime_platforms %},
  "runtimePlatform": {{ runtime_platforms | tojson }}
{% endif %}
{% set operating_systems = [] %}
{% for operating_system in cookiecutter.operating_systems.entries %}
{% if operating_system.name is defined and operating_system.name and (operating_system.status is not defined or operating_system.status in ["", "Officially supported", "Expected to work"]) %}
{% set label = operating_system.name ~ (" " ~ operating_system.specification if operating_system.specification is defined and operating_system.specification else "") %}
{% set _ = operating_systems.append(label) %}
{% endif %}
{% endfor %}
{% if operating_systems %},
  "operatingSystem": {{ operating_systems | tojson }}
{% endif %}
{% if cookiecutter.external_dependencies.entries %},
  "softwareRequirements": [
{% for dependency in cookiecutter.external_dependencies.entries %}
{{ codemeta_dependency(dependency) }}{% if not loop.last %},{% endif %}
{% endfor %}
  ]
{% endif %}
{% if supporting_data %},
  "supportingData": [
{% for data_feed in supporting_data %}
    {
      "@type": "DataFeed",
      "@id": {{ data_feed.url | tojson }},
      "name": {{ data_feed.name | tojson }},
      "url": {{ data_feed.url | tojson }}
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ]
{% endif %}
{% set funders = [] %}
{% for funding in cookiecutter.funding.entries %}
{% if funding.funder is defined and funding.funder and funding.funder not in funders %}{% set _ = funders.append(funding.funder) %}{% endif %}
{% endfor %}
{% if funders %},
  "funder": [
{% for funder in funders %}
    {
      "@type": "Organization",
      "name": {{ funder | tojson }}
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ]
{% endif %}
{% if cookiecutter.funding.entries %},
  "funding": [
{% for funding in cookiecutter.funding.entries %}
    {{ (funding.award_number if funding.award_number is defined and funding.award_number else funding.project_code if funding.project_code is defined and funding.project_code else funding.award_title if funding.award_title is defined and funding.award_title else funding.funder) | tojson }}{% if not loop.last %},{% endif %}
{% endfor %}
  ]
{% endif %}
{% set related_links = [] %}
{% for software in cookiecutter.related_software.entries %}
{% if software.url_or_doi is defined and software.url_or_doi and software.url_or_doi not in related_links %}{% set _ = related_links.append(software.url_or_doi) %}{% endif %}
{% endfor %}
{% if related_links %},
  "relatedLink": {{ related_links | tojson }}
{% endif %}
{% if registry_links %},
  "sameAs": {{ registry_links | tojson }}
{% endif %}
{% set publication_links = [] %}
{% for publication in cookiecutter.publications.entries %}
{% set link = publication_link(publication) | trim %}
{% if link %}{% set _ = publication_links.append({"link": link, "title": publication.title if publication.title is defined else ""}) %}{% endif %}
{% endfor %}
{% if publication_links %},
  "referencePublication": [
{% for publication in publication_links %}
    {
      "@type": "ScholarlyArticle",
      "@id": {{ publication.link | tojson }}{% if publication.title %},
      "name": {{ publication.title | tojson }}{% endif %}
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ]
{% endif %}
}
